<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mycobot_bridge</name>
  <version>0.1.0</version>
  <description>ROS 2 driver for myCobot 320 + myGripper F100 using pymycobot (socket / serial / fake)</description>
  <maintainer email="dhtjdalsqkqh@gmail.com">smoh</maintainer>
  <license>BSD</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>mycobot_description</exec_depend>
  <!-- pymycobot is installed with pip (pip3 install pymycobot) -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
