    <child link="link1"/>
    <origin rpy="0 0 0" xyz="0 0 0.181"/>
  </joint>
  <joint name="joint3_to_joint2" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.35" upper="2.35" velocity="1.0"/>
    <parent link="link1"/>
    <child link="link2"/>
    <origin rpy="0 -1.5708 1.5708" xyz="0 -0.08878 0"/>
  </joint>
  <joint name="joint4_to_joint3" type="revolute">
    <axis xyz=" 0 0 1"/>
    <limit effort="1000.0" lower="-2.53" upper="2.53" velocity="1.0"/>
    <parent link="link2"/>
    <child link="link3"/>
    <origin rpy="0 0 0" xyz="0.135 0 -0.08878   "/>
  </joint>
  <joint name="joint5_to_joint4" type="revolute">
    <axis xyz=" 0 0 1"/>
    <limit effort="1000.0" lower="-2.53" upper="2.53" velocity="1.0"/>
    <parent link="link3"/>
    <child link="link4"/>
    <origin rpy=" 0 0 1.57080" xyz="0.120 0 0.08878 "/>
  </joint>
  <joint name="joint6_to_joint5" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.93" upper="2.93" velocity="1.0"/>
    <parent link="link4"/>
    <child link="link5"/>
    <origin rpy="1.5708 0 0" xyz="0 -0.095 0.0"/>
  </joint>
  <joint name="joint6output_to_joint6" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-3.14" upper="3.14" velocity="1.0"/>
    <parent link="link5"/>
    <child link="link6"/>
    <origin rpy="-1.5708 0 0" xyz="0 0.0655 0.0"/>
  </joint>
  <!-- camera_flange_yaw (yaml, nominal 1.5708) points the camera arm to link6 +y, the side the
       gripper body does not occupy. It only places the flange mesh; the camera frame itself is
       set by link6_to_camera_optical below. -->
  <joint name="joint6output_to_camera_flange" type="fixed">
    <parent link="link6"/>
    <child link="camera_flange"/>
    <origin rpy="0 0 1.5708" xyz="0 0 0"/>
  </joint>
  <!-- camera extrinsics = hand-eye result. Nominal (from the flange mesh): lens centre at
       link6 (0, 0.0747, 0.016), optical axes parallel to link6 (z = approach direction). -->
  <joint name="link6_to_camera_optical_frame" type="fixed">
    <parent link="link6"/>
    <child link="camera_optical_frame"/>
    <origin rpy="0.006772 -0.009872 -0.009449" xyz="0.000327 0.074503 0.017019"/>
  </joint>
  <!-- inverse of the REP-103 body->optical rotation (rpy -pi/2 0 -pi/2) -->
  <joint name="camera_optical_frame_to_camera_link" type="fixed">
    <parent link="camera_optical_frame"/>
    <child link="camera_link"/>
    <origin rpy="1.5707963267948966 -1.5707963267948966 0" xyz="0 0 0"/>
  </joint>
  <!-- gripper sits on top of the 6 mm flange disc; the yaw undoes the flange yaw
       so the gripper keeps its original orientation relative to link6 -->
  <joint name="joint6output_to_gripper_connect" type="fixed">
    <parent link="camera_flange"/>
    <child link="gripper_connection"/>
    <origin rpy="0 0 -1.5708" xyz="0 0 0.006"/>
  </joint>
  <joint name="joint6output_to_gripper_base" type="fixed">
    <parent link="gripper_connection"/>
    <child link="gripper_base"/>
    <origin rpy="1.5708 0 0" xyz="0 -0.02 0.0364"/>
  </joint>
  <joint name="gripper_controller" type="revolute">
