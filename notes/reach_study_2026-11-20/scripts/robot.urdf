  <!-- tool center point: between the finger pads, z along the approach direction.
       gripper_controller 0 = closed, 1 = open (joint value in rad, NOT the 0-100 gripper command).
       Parallel-link fingers move on an arc: fingertip z (link6 frame) is ~0.166 closed and
       ~0.147 fully open, inner fingertip gap ~0 .. ~110 mm in the mesh model.
       The TCP offset is a fixed estimate - measure on the real gripper and set it in the yaml. -->
  <link name="gripper_tcp"/>
  <joint name="joint2_to_joint1" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-2.93" upper="2.93" velocity="1.0"/>
